    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "acorn": "^8.19.0",
    "concurrently": "^10.0.6",
    "dompurify": "3.4.17",
